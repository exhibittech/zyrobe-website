# Zyrobe API reverse proxy. Traffic arrives only via Cloudflare (firewall-enforced).
# TLS: Cloudflare Origin CA certificate (Cloudflare SSL mode = Full (strict)).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP
	}
}

api.zyrobe.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	reverse_proxy 127.0.0.1:8000 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
	log {
		output file /var/log/caddy/api.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

# Public website. The marketing site is a static Next.js export from exhibittech/zyrobe-website,
# deployed to /var/www/zyrobe-site/releases/<id> with `current` -> the live release (its deploy/deploy.sh).
# It also serves /privacy and /terms (Google Play links to https://zyrobe.com/privacy and #delete-account).
zyrobe.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# /privacy/ -> /privacy (pages are exported as <name>.html). Only plain path segments match and the
	# target is an absolute URL on our own host, so "//evil.com/" can never become an off-site redirect.
	@trailing path_regexp trailing ^(/[A-Za-z0-9_-][A-Za-z0-9_./-]*)/$
	redir @trailing https://zyrobe.com{re.trailing.1}{?query} 308

	handle {
		root * /var/www/zyrobe-site/current
		@hashed path /_next/static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@media path /media/*
		header @media Cache-Control "public, max-age=604800"
		@page not path /_next/static/* /media/*
		header @page Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		root * /var/www/zyrobe-site/current
		rewrite * /404.html
		file_server
	}

	log {
		output file /var/log/caddy/site.log {
			roll_size 20MiB
			roll_keep 3
		}
	}
}

www.zyrobe.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	redir https://zyrobe.com{uri} permanent
}
